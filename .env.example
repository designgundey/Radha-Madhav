# Copy this file to .env and fill in real values before deploying.
# The site currently reads none of these at build time — they're placeholders
# for the integrations you'll likely add (analytics, a contact form backend).

# Public site URL, used for canonical links / sitemap generation.
PUBLIC_SITE_URL=https://radhamadhavmedicalhall.example.com

# Mapbox token for the dark footer/contact map (https://account.mapbox.com/access-tokens/).
# Leave empty and the site falls back to a Google Maps embed.
PUBLIC_MAPBOX_TOKEN=

# Example: analytics
# PUBLIC_ANALYTICS_ID=

# Example: if a contact form is wired to a backend/email service later
# CONTACT_FORM_ENDPOINT=
