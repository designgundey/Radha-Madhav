---
interface Props {
  value: number;
  class?: string;
}
const { value, class: className } = Astro.props;
const filled = Math.round(value);
---

<span class:list={["stars", className]} role="img" aria-label={`${value} out of 5 stars`}>
  {
    [1, 2, 3, 4, 5].map((n) => (
      <svg viewBox="0 0 24 24" aria-hidden="true" class:list={{ on: n <= filled }}>
        <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" />
      </svg>
    ))
  }
</span>
