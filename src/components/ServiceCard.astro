---
import Icon from "./Icon.astro";
import type { Service } from "../data/services";
import { getLang, l, localePath } from "../i18n";

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<a
  class="img-card"
  href={localePath(`/services/#${service.slug}`, lang)}
  data-reveal
  style={`--reveal-delay:${(index % 3) * 110}ms`}
>
  <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
  {service.tag && <span class="tag">{l(service.tag, lang)}</span>}
  <div class="img-card-body">
    <div class="img-card-icon"><Icon name={service.icon} /></div>
    <h3>{l(service.title, lang)}</h3>
    <p>{l(service.description, lang)}</p>
  </div>
</a>
