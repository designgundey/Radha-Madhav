---
import Icon from "./Icon.astro";
import { galleryTiles } from "../data/gallery";
import { getLang, l, useT } from "../i18n";

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="gallery">
  <div class="wrap">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">{t("gallery.eyebrow")}</p>
      <h2>{t("gallery.title")}</h2>
      <p>{t("gallery.sub")}</p>
    </div>
    <div class="gallery-grid">
      {
        galleryTiles.map((tile, i) => (
          <article class="img-card" data-reveal style={`--reveal-delay:${(i % 3) * 110}ms`}>
            <img src={tile.src} alt={tile.alt} loading="lazy" decoding="async" />
            <div class="img-card-body">
              <div class="img-card-icon">
                <Icon name={tile.icon} />
              </div>
              <h3>{l(tile.title, lang)}</h3>
              <p>{l(tile.caption, lang)}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
